# Busk Seguros - Configuración de Entorno
# Copiar este archivo a .env y reemplazar valores con los reales

# ===== DATABASE =====
# Para servidor con MySQL local
MYSQL_DSN=busk:busk123@tcp(localhost:3306)/busk?parseTime=true&multiStatements=true

# Para desarrollo con MySQL en Docker
# MYSQL_DSN=busk:busk123@tcp(mysql:3306)/busk?parseTime=true&multiStatements=true

# MySQL root password (solo si usas docker-compose.yml con MySQL en Docker)
MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=busk123
MYSQL_DATABASE=busk
MYSQL_PORT=3306

# ===== API SERVER =====
API_PORT=8080

# ===== PROCESSING =====
PROCESSOR_WORKERS=2
PROCESSOR_READ_FULL_FILE_ON_ROW_ERRORS=false

# ===== ARCHIVE DIRECTORIES =====
FILES_ARCHIVE_DIR=/data/files-archive
REPORTS_ARCHIVE_DIR=/data/reports-archive

# ===== SFTP CONFIGURATION =====
# Credenciales de conexión a SFTP de aseguradoras
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USER=tu_usuario_sftp
SFTP_PASSWORD=tu_password_sftp
SFTP_REMOTE_DIR=/incoming

# ===== EMAIL NOTIFICATIONS =====
# SendGrid configuration (opcional - si no se configura, notificaciones se silencian)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@busk.com
SENDGRID_ERROR_TO_EMAILS=ops@busk.com,admin@busk.com

# ===== DOCKER COMPOSE =====
# Solo si usas docker-compose.yml (con MySQL en Docker)
# COMPOSE_FILE=docker-compose.yml

# Para servidor (MySQL local)
# COMPOSE_FILE=docker-compose.servidor.yml
