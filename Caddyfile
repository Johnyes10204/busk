# Caddy reverse proxy para Busk Seguros API
# Escucha en puerto 80, redirige HTTP → HTTPS automáticamente
# HTTPS disponible en puerto 443

# Cambiar esto a tu dominio o IP
# Ejemplos:
#   - api.busk.com          (Let's Encrypt automático)
#   - 62.146.228.79         (certificado auto-signed)

62.146.228.79 {
	# Reverse proxy a la API (en red Docker interna)
	reverse_proxy http://api:8080 {
		# Headers para preservar información original
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Forwarded-Proto {http.request.proto}
		header_up X-Forwarded-Host {http.request.host}
	}

	# Logs
	log {
		output stdout
		format json
	}
}
