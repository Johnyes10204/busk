{
  "info": {
    "name": "Busk Seguros API",
    "description": "Colección completa y operativa paso a paso para el flujo E2E: bootstrap de productos/parametrías, gestión de primas permitidas, scan SFTP, seguimiento de progreso, consulta de archivos, descarga del archivo archivado, y consultas de pólizas (listado + búsqueda paginada). Incluye carpeta '00 - Flujo E2E Paso a Paso' para ejecutar en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "3f9a5ef1-busk-seguros-api-collection"
  },
