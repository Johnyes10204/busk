# Recomendado: usar config.json (copiar desde config.example.json).
# .env queda como mecanismo alterno/fallback.
# La API intenta cargar config.json o services/api/config.json.
# Si no existe, usa variables de entorno y/o .env.

# MySQL (obligatorio en producción; vacío usa DSN por defecto del código)
MYSQL_DSN=root@tcp(127.0.0.1:3306)/busk?parseTime=true&multiStatements=true

# Cola de procesamiento de archivos
PROCESSOR_WORKERS=2
# true / 1 / yes: ante error en una fila sigue leyendo todo el archivo (MANUAL_REVIEW + NOVEDAD)
# false / fail_fast / strict: aborta en el primer error de fila
PROCESSOR_READ_FULL_FILE_ON_ROW_ERRORS=true

# Archivos descargados / archivo temporal de validación
FILES_ARCHIVE_DIR=

# SFTP (processor scan)
SFTP_HOST=192.168.46.101
SFTP_PORT=2222
SFTP_USER=usuario_ftp
SFTP_PASSWORD=
SFTP_REMOTE_DIR=.

# Notificaciones por correo cuando un archivo termina en ERROR
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alertas@buskseguros.com
SENDGRID_ERROR_TO_EMAILS=equipo@buskseguros.com
# URL pública de la API (enlace de descarga del Excel si el adjunto supera el límite de tamaño)
API_PUBLIC_BASE_URL=http://localhost:8080
